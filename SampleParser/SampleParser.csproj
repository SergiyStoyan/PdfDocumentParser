<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<ForceDesignerDPIUnaware>true</ForceDesignerDPIUnaware>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<!-- Optional: Keeps legacy default font (Microsoft Sans Serif 8.25pt) instead of Segoe UI 9pt -->
		<!--ApplicationDefaultFont>Microsoft Sans Serif, 8.25pt</ApplicationDefaultFont-->
		
		<Version>2.0.0</Version>
		<Authors>Sergiy Stoyan</Authors>
		<Company>CliverSoft</Company>
		<Copyright>Sergiy Stoyan</Copyright>
		<RootNamespace>Cliver.SampleParser</RootNamespace>
		<Platforms>AnyCPU;x64</Platforms>
		<ApplicationIcon>computers308.ico</ApplicationIcon>

	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="config\**" />
	  <Compile Remove="test_files\**" />
	  <EmbeddedResource Remove="config\**" />
	  <EmbeddedResource Remove="test_files\**" />
	  <None Remove="config\**" />
	  <None Remove="test_files\**" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="3RINGS~1.ICO" />
	  <None Remove="computers308.ico" />
	  <None Remove="install.iss" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="CliverRoutines" Version="7.0.0" />
	  <PackageReference Include="CliverWinRoutines" Version="3.0.1.594" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\PdfDocumentParser.csproj" />
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
	  <Exec Command="xcopy /Y /S &quot;$(ProjectDir)config&quot; &quot;$(TargetDir)&quot;&#xD;&#xA;xcopy /Y /S &quot;$(ProjectDir)..\externals&quot; &quot;$(TargetDir)&quot;&#xD;&#xA;xcopy /Y /S &quot;$(ProjectDir)..\config&quot; &quot;$(TargetDir)&quot;&#xD;&#xA;xcopy /Y /S &quot;$(ProjectDir)..\docs&quot; &quot;$(TargetDir)PdfDocumentParserDocs\&quot;" />
	</Target>

</Project>
